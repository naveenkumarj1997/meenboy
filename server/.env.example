PORT=5000
NODE_ENV=production

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/meenboy?retryWrites=true&w=majority

# Security
JWT_SECRET=replace-with-a-very-long-secure-random-string
JWT_EXPIRES_IN=7d

# Frontend URL (For CORS - Replace with your Vercel URL)
CLIENT_URL=https://your-vercel-app-name.vercel.app

# ─── Free email alerts (Admin Notifications) ─────────────────────────────────
# Optional. If unset, website bookings still work; emails are skipped.
# Resend free SMTP example:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxx
#   SMTP_FROM=Fish Friendly <onboarding@resend.dev>
# Gmail App Password example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM=Fish Friendly <your@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
